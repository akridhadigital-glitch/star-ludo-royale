# Copy to .env and fill in. Never commit .env.
DATABASE_URL=postgres://ludo:ludo@localhost:5432/ludo
REDIS_URL=redis://localhost:6379
# Generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string-of-64-chars-minimum-please
PORT=8080
# Comma-separated origins allowed to call the API (or * during development)
CORS_ORIGIN=*
# Firebase project id — only needed for Google sign-in. Guest login works without it.
FIREBASE_PROJECT_ID=
TURN_SECONDS=15
